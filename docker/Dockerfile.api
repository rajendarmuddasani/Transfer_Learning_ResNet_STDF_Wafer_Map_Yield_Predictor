FROM cgr.dev/chainguard/python:latest-dev AS builder

WORKDIR /app
COPY requirements-public.txt ./
RUN python -m pip install --no-cache-dir --user -r requirements-public.txt

FROM cgr.dev/chainguard/python:latest

ENV APP_ENV=production \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/nonroot/.local/bin:${PATH}"

WORKDIR /app
COPY --from=builder /home/nonroot/.local /home/nonroot/.local
COPY --chown=65532:65532 config/api_config.yaml ./config/
COPY --chown=65532:65532 evidence/public_synthetic_evaluation.json ./evidence/
COPY --chown=65532:65532 models/public_synthetic_resnet18_v1.json ./models/
COPY --chown=65532:65532 models/onnx/public_synthetic_resnet18_v1.onnx ./models/onnx/
COPY --chown=65532:65532 src ./src

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/readiness', timeout=3)"]

ENTRYPOINT ["python"]
CMD ["-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
